# SSD Digital Command & Membership Platform Environment Configuration
PORT=3000
NODE_ENV=development

# ==============================================================================
# SUPABASE DATABASE & CLOUD CONFIGURATION
# ==============================================================================
# 1. Supabase Project REST API URL (From Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous Public Key (For browser client / public calls)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Supabase Service Role Secret Key (For backend server - bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. Supabase PostgreSQL Connection String (From Settings -> Database -> Connection Pooling / Direct)
# Example (Session Pooler): postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Example (Direct): postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret for Session & Authentication
JWT_SECRET=ssd_prod_secret_key_change_in_production_1927_2027
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Email Notification Service (Gmail SMTP / Resend)
SENDER_EMAIL=samyak.ssd@gmail.com
GMAIL_APP_PASSWORD=
RESEND_API_KEY=

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
