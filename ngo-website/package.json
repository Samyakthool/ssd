  "description": "Official Digital Command & Membership Platform for Samata Sainik Dal",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:next": "next dev",
    "build": "next build && node scripts/sync-public.js",
    "migrate": "node backend/db/migrate.js",
    "migrate:supabase": "node backend/db/supabase-migrate.js",
    "test:api": "node backend/tests/run-tests.js",
    "test:security": "tsx src/tests/security.test.ts",
    "test:db": "tsx src/tests/database.test.ts",
    "test:auth": "tsx src/tests/auth.test.ts",
    "test:pipeline": "tsx src/tests/pipeline.test.ts",
    "test:all": "node backend/tests/run-tests.js && tsx src/tests/security.test.ts && tsx src/tests/database.test.ts && tsx src/tests/auth.test.ts && tsx src/tests/pipeline.test.ts"
  },
  "dependencies": {
    "@supabase/server": "^1.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "next": "^16.3.8",
    "nodemailer": "^6.9.15",
    "otplib": "^13.5.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
